#    LLM_PROVIDER: anthropic | openai | gemini | ollama
#    Ejemplo con Gemini:  LLM_PROVIDER=gemini  y  LLM_MODEL=gemini-3.5-flash
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Temperatura: solo se envía a openai/ollama. Claude la rechaza (error 400) y
# para Gemini se deja el valor por defecto recomendado por Google.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=16000
# Claude y Gemini: profundidad de razonamiento (low | medium | high | xhigh | max).
# En Gemini xhigh/max equivalen a high. Vacío = valor por defecto del modelo.
# Más bajo = respuestas más rápidas; con Gemini "low" evita esperas largas.
LLM_EFFORT=medium
# Segundos máximos por llamada al LLM y reintentos ante errores del servidor
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Claves: solo necesitas la del proveedor que uses
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Ollama local (instalar desde ollama.com y luego: ollama pull <modelo>)
OLLAMA_BASE_URL=http://localhost:11434

#    EMBEDDINGS_DEVICE: mps (Mac Apple Silicon) | cpu | cuda
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_DEVICE=mps

# 3. Base vectorial (ChromaDB persistente en disco)
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=nju_resultados
RAG_TOP_K=6

# 4. Resultados del pipeline YOLO (entradas del RAG)
# Vacío = usa el best.pt más reciente dentro de runs_nju/
YOLO_WEIGHTS=
YOLO_CONF=0.25
YOLO_IMGSZ=640
TILE_SIZE=1024
TILE_OVERLAP=128
DEDUP_IOU=0.6
# Cuadrícula para describir la posición de las detecciones (filas x columnas)
GRID_FILAS=4
GRID_COLUMNAS=4

DETECCIONES_DIR=./resultados/detecciones
METRICAS_PATH=./metricas.json
GRAFICAS_DIR=./resultados/graficas

# 5. Hugging Face (para descargar el dataset / modelos de embeddings)
HF_TOKEN=

# 6. Observabilidad (opcional): trazas del agente en LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-nju-yolo

# 7. General
LOG_LEVEL=INFO
